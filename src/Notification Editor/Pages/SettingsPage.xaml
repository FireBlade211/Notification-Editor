<Page
    x:Class="FireBlade.NotificationEditor.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FireBlade.NotificationEditor.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    xmlns:controls="using:FireBlade.NotificationEditor.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" x:Name="rootGrid">
        <Pivot Title="SETTINGS">
            <Pivot.LeftHeader>
                <Button Style="{StaticResource NavigationBackButtonNormalStyle}" x:Name="backButton" Click="BackButton_Click"/>
            </Pivot.LeftHeader>

            <PivotItem Header="General">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="App theme"/>
                        <RadioButton Content="Use system setting" x:Name="systemThemeRadio" Checked="SystemThemeRadio_Checked"/>
                        <RadioButton Content="Light"              x:Name="lightThemeRadio"  Checked="SystemThemeRadio_Checked"/>
                        <RadioButton Content="Dark"               x:Name="darkThemeRadio"   Checked="SystemThemeRadio_Checked"/>

                        <ToggleSwitch x:Name="useAcrylicToggle" Toggled="useAcrylicToggle_Toggled"
                                      Header="Use acrylic background behind Preview Pane" Margin="0,8,0,0"/>
                        <CheckBox x:Name="revealButtonBox" Content="Use Reveal-styled buttons"
                                  Checked="revealButtonBox_Checked" Unchecked="revealButtonBox_Checked"/>

                        <StackPanel Orientation="Horizontal" x:Name="revealButtonsRestartPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="You need to restart the app to apply these changes."
                                       TextWrapping="WrapWholeWords" VerticalAlignment="Center"/>
                            <Button Content="Restart now" x:Name="revealButtonsRestartButton" Click="revealButtonsRestartButton_Click"
                                    Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Preview">
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Visible">
                    <StackPanel Margin="0,0,0,8">

                        <!-- NOTE: I can't use a ColorPicker because that's not in 10240 -->
                        <controls:ColorBox Header="Tile background color" x:Name="tileColorBox" ColorChanged="TileColorBox_ColorChanged"
                             ToolTipService.ToolTip="Specify the live tile background color (using hex or a named color)"/>

                        <controls:ColorBox Header="App logo background" Margin="0,8,0,0" ColorChanged="LogoColorBox_ColorChanged"
                             ToolTipService.ToolTip="Specify the background of the app logo" x:Name="logoColorBox"/>

                        <TextBox Header="App display name" Margin="0,8,0,0" x:Name="previewDisplayNameBox" LostFocus="PreviewDisplayNameBox_LostFocus"/>

                        <TextBlock Text="APP LOGO" Style="{StaticResource PivotTitleTextBlockStyle}" Margin="0,8,0,4"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="310x310"/>

                                <Button Width="310" Height="310" Padding="0" ToolTipService.ToolTip="Square310x310Logo">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Reset to default" Tag="310x310" Click="ResetLogoDefault_Click"/>
                                            <MenuFlyoutItem Text="Pick custom logo" Tag="310x310" Click="PickCustomLogo_Click"/>
                                        </MenuFlyout>
                                    </Button.Flyout>

                                    <Image Source="ms-appx:///Assets/LargeTile.png" x:Name="imgLogo310x310"/>
                                </Button>

                                <CheckBox Content="Show name" x:Name="showNameOnLargeLogoCheck" Checked="ShowNameOnLargeLogoCheck_Checked"
                                          Unchecked="ShowNameOnLargeLogoCheck_Checked"/>
                            </StackPanel>

                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="310x150"/>

                                <Button Width="310" Height="150" Padding="0" ToolTipService.ToolTip="Wide310x150Logo">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Reset to default" Tag="310x150" Click="ResetLogoDefault_Click"/>
                                            <MenuFlyoutItem Text="Pick custom logo" Tag="310x150" Click="PickCustomLogo_Click"/>
                                        </MenuFlyout>
                                    </Button.Flyout>

                                    <Image Source="ms-appx:///Assets/Wide310x150Logo.png" x:Name="imgLogo310x150"/>
                                </Button>

                                <CheckBox Content="Show name" x:Name="showNameOnWideLogoCheck" Checked="ShowNameOnWideLogoCheck_Checked"
                                          Unchecked="ShowNameOnWideLogoCheck_Checked"/>
                            </StackPanel>

                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="150x150"/>

                                <Button Width="150" Height="150" Padding="0" ToolTipService.ToolTip="Square150x150Logo">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Reset to default" Tag="150x150" Click="ResetLogoDefault_Click"/>
                                            <MenuFlyoutItem Text="Pick custom logo" Tag="150x150" Click="PickCustomLogo_Click"/>
                                        </MenuFlyout>
                                    </Button.Flyout>

                                    <Image Source="ms-appx:///Assets/Square150x150Logo.png" x:Name="imgLogo150x150"/>
                                </Button>
                                
                                <CheckBox Content="Show name" x:Name="showNameOnSmallLogoCheck" Checked="ShowNameOnSmallLogoCheck_Checked"
                                          Unchecked="ShowNameOnSmallLogoCheck_Checked"/>
                            </StackPanel>

                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="71x71"/>

                                <Button Width="71" Height="71" Padding="0" ToolTipService.ToolTip="Square71x71Logo">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Reset to default" Tag="71x71" Click="ResetLogoDefault_Click"/>
                                            <MenuFlyoutItem Text="Pick custom logo" Tag="71x71" Click="PickCustomLogo_Click"/>
                                        </MenuFlyout>
                                    </Button.Flyout>

                                    <Image Source="ms-appx:///Assets/SmallTile.png" x:Name="imgLogo71x71"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="44x44"/>

                                <Button Width="44" Height="44" Padding="0" ToolTipService.ToolTip="Square44x44Logo">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Reset to default" Tag="44x44" Click="ResetLogoDefault_Click"/>
                                            <MenuFlyoutItem Text="Pick custom logo" Tag="44x44" Click="PickCustomLogo_Click"/>
                                        </MenuFlyout>
                                    </Button.Flyout>

                                    <Image Source="ms-appx:///Assets/Square44x44Logo.png" x:Name="imgLogo44x44"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="About">
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,8">
                        <Grid>
                            <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="Notification Editor"/>
                            <HyperlinkButton Content="Edit settings file" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0"
                                             x:Name="editFileButton" Click="EditFileButton_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource SubheaderTextBlockStyle}" Text="Version 1.0" x:Name="versionBlock" />

                        <TextBlock TextWrapping="WrapWholeWords">
                        <Bold>Notification Editor</Bold> is a schema-compliant editor for Windows toast and tile notifications.<LineBreak/><LineBreak/>
                        Copyright © FireBlade 2026
                        </TextBlock>

                        <TextBox IsReadOnly="True" Header="License" AcceptsReturn="True" MinHeight="500" Margin="0,16,0,0">
                            <TextBox.Text>
                                <x:String xml:space="preserve">MIT License

Copyright (c) 2026 FireBlade

