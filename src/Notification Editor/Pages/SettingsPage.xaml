SOFTWARE.</x:String>
                            </TextBox.Text>
                        </TextBox>

                        <TextBlock Margin="0,8,0,0">
                        Dependencies &amp; references:<LineBreak/><LineBreak/>
                        <Hyperlink NavigateUri="https://learn.microsoft.com/windows/uwp">Universal Windows Platform (UWP)</Hyperlink><LineBreak/>
                        <Hyperlink NavigateUri="https://newtonsoft.com/json">Newtonsoft Json.NET</Hyperlink><LineBreak/>
                        <Hyperlink NavigateUri="https://nuget.org/packages/NotificationsVisualizerLibrary">Notifications Visualizer Library</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
