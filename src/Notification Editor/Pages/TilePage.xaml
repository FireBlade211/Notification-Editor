<Page
    x:Class="FireBlade.NotificationEditor.Pages.TilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FireBlade.NotificationEditor.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    xmlns:visualizer="using:NotificationsVisualizerLibrary"
    xmlns:markup="using:FireBlade.NotificationEditor.Markup"
    Loaded="Page_Loaded"
    xmlns:data="using:FireBlade.NotificationEditor.DataModel"
    xmlns:controls="using:FireBlade.NotificationEditor.Controls"
    xmlns:dialogs="using:FireBlade.NotificationEditor.Dialogs">

    <Page.Resources>
        <markup:TypeConfirmConverter x:Key="typeConfirmConverter" />
        <markup:BoolToVisibilityConverter x:Key="boolToVisiblityConverter"/>
        <markup:DoubleToTileDensityConverter x:Key="doubleToDensityConverter"/>
        <markup:StringToIntConverter x:Key="stringToIntConverter"/>

        <MenuFlyout x:Key="TileImageFlyout">
            <MenuFlyoutItem Text="Save as image" x:Name="saveImageButton" Click="SaveImageButton_Click"/>
            <MenuFlyoutItem Text="Copy as image" x:Name="copyImageButton" Click="CopyImageButton_Click"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Share image" x:Name="shareImageButton" Click="ShareImageButton_Click"/>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="266*"/>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="2" MinWidth="376" Visibility="{x:Bind showPreviewButton.IsChecked, Mode=OneWay, Converter={StaticResource boolToVisiblityConverter}}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" x:Name="previewPane" Padding="8,8,8,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <ComboBox DisplayMemberPath="DisplayString" ItemsSource="{x:Bind Builds}" SelectedValuePath="LongBuildNumber" MinWidth="160"
                      Header="OS Build" x:Name="osBuildCombo" SelectedValue="10240" />

                <Slider Header="UI Density %" x:Name="densitySlider" Margin="16,0,0,0" MinWidth="180" Maximum="200" Minimum="100"
                        Value="100"/>
            </StackPanel>

            <MenuFlyoutSeparator Margin="0,8" Grid.Row="1" />

            <ScrollViewer Grid.Row="2">
                <StackPanel Margin="8,0,8,8">
                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="Desktop" Margin="4,0,0,2"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Small" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="desktopSmallTile" Margin="0,0,0,12" TileSize="Small"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Desktop}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Medium" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="desktopMediumTile" Margin="0,0,0,12" TileSize="Medium"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Desktop}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Wide" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="desktopWideTile" Margin="0,0,0,12" TileSize="Wide"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Desktop}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Large" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="desktopLargeTile" Margin="0,0,0,12" TileSize="Large"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Desktop}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="Mobile" Margin="4,0,0,2"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Small" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="mobileSmallTile" DeviceFamily="Mobile" Margin="0,0,0,12" TileSize="Small"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Mobile}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Medium" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="mobileMediumTile" DeviceFamily="Mobile" Margin="0,0,0,12" TileSize="Medium"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Mobile}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Wide" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="mobileWideTile" DeviceFamily="Mobile" Margin="0,0,0,12" TileSize="Wide"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Mobile}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Large" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="mobileLargeTile" DeviceFamily="Mobile" Margin="0,0,0,12" TileSize="Large"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Mobile}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="Tablet" Margin="4,0,0,2"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Small" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="tabletSmallTile" DeviceFamily="Mobile" Margin="0,0,0,12" TileSize="Small"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Tablet}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Medium" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="tabletMediumTile" DeviceFamily="Mobile" Margin="0,0,0,12" TileSize="Medium"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Tablet}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Wide" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="tabletWideTile" DeviceFamily="Mobile" Margin="0,0,0,12" TileSize="Wide"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Tablet}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Large" Margin="4,0,0,2"/>

                    <visualizer:PreviewTile x:Name="tabletLargeTile" DeviceFamily="Mobile" Margin="0,0,0,12" TileSize="Large"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     TileDensity="{x:Bind densitySlider.Value,Mode=OneWay,Converter={StaticResource doubleToDensityConverter},ConverterParameter=Tablet}"
                                     IsAnimationEnabled="{x:Bind animateEnabledButton.IsChecked,Mode=OneWay}" Tapped="TilePreview_Tapped"
                                     IsRightTapEnabled="True" RightTapped="TilePreview_RightTapped"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Pivot Title="LIVE TILE EDITOR" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch">
            <Pivot.RightHeader>
                <!-- HACK: SplitButton was not in 10240, so we improvize -->
                <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Content="Pin / Update" Width="100" Height="32" Margin="0,0,2,0" x:Name="pinButton" Click="PinButton_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="&#xE70D;" FontFamily="{StaticResource SymbolThemeFontFamily}" Height="32">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <ToggleMenuFlyoutItem Text="Show preview" x:Name="showPreviewButton" IsChecked="True"/>
                                <ToggleMenuFlyoutItem Text="Show update animation" x:Name="animateEnabledButton" IsChecked="True"
                                                      IsEnabled="{x:Bind showPreviewButton.IsChecked,Mode=OneWay}"/>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Set as Primary Tile" x:Name="setPrimaryButton" Click="SetPrimaryButton_Click"/>
                                <MenuFlyoutItem Text="Share" x:Name="shareButton" Click="ShareButton_Click">
                                    <!--
                                    <MenuFlyoutItem.Command>
                                        <StandardUICommand Kind="Share"/>
                                    </MenuFlyoutItem.Command>
                                    -->
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Save" x:Name="saveButton" Click="SaveButton_Click">
                                    <!--
                                    <MenuFlyoutItem.Command>
                                        <StandardUICommand Kind="Save"/>
                                    </MenuFlyoutItem.Command>
                                    -->
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save as..." x:Name="saveAsButton" Click="SaveAsButton_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Pivot.RightHeader>

            <PivotItem Header="Home">
                <ScrollViewer>
                    <StackPanel>
                        <ComboBox Header="Version" HorizontalAlignment="Stretch" SelectedIndex="0"
                                  x:Name="versionCombo" SelectedValuePath="Tag" SelectionChanged="VersionCombo_SelectionChanged">
                            <ComboBoxItem Content="Windows 10"             Tag=""/>
                            <ComboBoxItem Content="v1 (Windows 8)"         Tag="1"/>
                            <ComboBoxItem Content="v2 (Windows 8.1)"       Tag="2"/>
                            <ComboBoxItem Content="v3 (Windows Phone 8.1)" Tag="3"/>
                        </ComboBox>

                        <ToggleSwitch Header="Add query to image URIs" Margin="0,8,0,0" x:Name="addImageQueryToggle"
                                      Toggled="AddImageQueryToggle_Toggled"/>

                        <TextBox Header="Image Base URI" Margin="0,8,0,0" x:Name="baseUriBox"
                                 LostFocus="BaseUriBox_LostFocus"/>

                        <ComboBox Header="Branding" HorizontalAlignment="Stretch" Margin="0,8,0,0" SelectedIndex="0"
                                  SelectedValuePath="Tag" x:Name="brandingCombo" SelectionChanged="BrandingCombo_SelectionChanged">
                            <ComboBoxItem Content="Default" Tag=""/>
                            <ComboBoxItem Content="None" Tag="none"/>
                            <ComboBoxItem Content="Logo" Tag="logo"/>
                            <ComboBoxItem Content="Name" Tag="name"/>
                            <ComboBoxItem Content="Name &amp; Logo" Tag="nameAndLogo"/>
                        </ComboBox>

                        <TextBox Header="Content ID (optional)" Margin="0,8,0,0" x:Name="contentIdBox"
                                 LostFocus="ContentIdBox_LostFocus">
                            <ToolTipService.ToolTip>
                                <ToolTip>
                                    <TextBlock TextWrapping="WrapWholeWords">
                                        A sender-defined string that uniquely identifies the content of the notification.
                                        This prevents duplicates in the situation where a large tile template is displaying
                                        the last three wide tile notifications.
                                    </TextBlock>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </TextBox>

                        <TextBox Header="Display name" Margin="0,8,0,0" x:Name="displayNameBox"
                                 LostFocus="DisplayNameBox_LostFocus"/>

                        <TextBox Header="Language" Margin="0,8,0,0" x:Name="tileLangBox"
                                 LostFocus="TileLangBox_LostFocus"/>

                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Bindings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Add Binding" x:Name="addBindingButton" Click="AddBindingButton_Click"/>

                    <ListView Grid.Row="1" SelectionMode="None" ItemsSource="{x:Bind TileBindings,Mode=OneWay}" Margin="0,8,0,0"
                              ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Visible">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="data:TileBinding">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{x:Bind TemplateName,Mode=TwoWay}"
                                              MinWidth="180" Header="Template" VerticalAlignment="Bottom">

                                            <ComboBoxItem Content="Small" Tag="TileSmall"/>
                                            <ComboBoxItem Content="Medium" Tag="TileMedium"/>
                                            <ComboBoxItem Content="Wide" Tag="TileWide"/>
                                            <ComboBoxItem Content="Large" Tag="TileLarge"/>
                                            <ComboBoxItem Content="Small (Iconic)" Tag="TileSquare71x71IconWithBadge"/>
                                            <ComboBoxItem Content="Large (Iconic)" Tag="TileSquare150x150IconWithBadge"/>
                                        </ComboBox>

                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{x:Bind FallbackName,Mode=TwoWay}"
                                              MinWidth="180" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                                            <ComboBox.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Fallback" VerticalAlignment="Bottom"/>
                                                    <HyperlinkButton Content="View more" NavigateUri="https://learn.microsoft.com/previous-versions/windows/apps/hh761491(v=win.10)"
                                                                 ToolTipService.ToolTip="Visit the Tile Template Catalog to see more info about legacy tile templates."
                                                                 Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0"/>
                                                </Grid>
                                            </ComboBox.Header>

                                            <ComboBoxItem Content="None" Tag=""/>
                                            <ComboBoxItem Content="Square (150x150) Image" Tag="TileSquare150x150Image"/>
                                            <ComboBoxItem Content="Square (150x150) Block" Tag="TileSquare150x150Block"/>
                                            <ComboBoxItem Content="Square (150x150) Text 1" Tag="TileSquare150x150Text01"/>
                                            <ComboBoxItem Content="Square (150x150) Text 2" Tag="TileSquare150x150Text02"/>
                                            <ComboBoxItem Content="Square (150x150) Text 3" Tag="TileSquare150x150Text03"/>
                                            <ComboBoxItem Content="Square (150x150) Text 4" Tag="TileSquare150x150Text04"/>
                                            <ComboBoxItem Content="Square (150x150) Peek Image and Text 1" Tag="TileSquare150x150PeekImageAndText01"/>
                                            <ComboBoxItem Content="Square (150x150) Peek Image and Text 2" Tag="TileSquare150x150PeekImageAndText02"/>
                                            <ComboBoxItem Content="Square (150x150) Peek Image and Text 3" Tag="TileSquare150x150PeekImageAndText03"/>
                                            <ComboBoxItem Content="Square (150x150) Peek Image and Text 4" Tag="TileSquare150x150PeekImageAndText04"/>
                                            <ComboBoxItem Content="Wide (310x150) Image" Tag="TileWide310x150Image"/>
                                            <ComboBoxItem Content="Wide (310x150) Image Collection" Tag="TileWide310x150ImageCollection"/>
                                            <ComboBoxItem Content="Wide (310x150) Image and Text 1" Tag="TileWide310x150ImageAndText01"/>
                                            <ComboBoxItem Content="Wide (310x150) Image and Text 2" Tag="TileWide310x150ImageAndText02"/>
                                            <ComboBoxItem Content="Wide (310x150) Block and Text 1" Tag="TileWide310x150BlockAndText01"/>
                                            <ComboBoxItem Content="Wide (310x150) Block and Text 2" Tag="TileWide310x150BlockAndText02"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image Collection 1" Tag="TileWide310x150PeekImageCollection01"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image Collection 2" Tag="TileWide310x150PeekImageCollection02"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image Collection 3" Tag="TileWide310x150PeekImageCollection03"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image Collection 4" Tag="TileWide310x150PeekImageCollection04"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image Collection 5" Tag="TileWide310x150PeekImageCollection05"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image Collection 6" Tag="TileWide310x150PeekImageCollection06"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image and Text 1" Tag="TileWide310x150PeekImageAndText01"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image and Text 2" Tag="TileWide310x150PeekImageAndText02"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image 1" Tag="TileWide310x150PeekImage01"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image 2" Tag="TileWide310x150PeekImage02"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image 3" Tag="TileWide310x150PeekImage03"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image 4" Tag="TileWide310x150PeekImage04"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image 5" Tag="TileWide310x150PeekImage05"/>
                                            <ComboBoxItem Content="Wide (310x150) Peek Image 6" Tag="TileWide310x150PeekImage06"/>
                                            <ComboBoxItem Content="Wide (310x150) Small Image and Text 1" Tag="TileWide310x150SmallImageAndText01"/>
                                            <ComboBoxItem Content="Wide (310x150) Small Image and Text 2" Tag="TileWide310x150SmallImageAndText02"/>
                                            <ComboBoxItem Content="Wide (310x150) Small Image and Text 3" Tag="TileWide310x150SmallImageAndText03"/>
                                            <ComboBoxItem Content="Wide (310x150) Small Image and Text 4" Tag="TileWide310x150SmallImageAndText04"/>
                                            <ComboBoxItem Content="Wide (310x150) Small Image and Text 5" Tag="TileWide310x150SmallImageAndText05"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 1" Tag="TileWide310x150Text01"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 2" Tag="TileWide310x150Text02"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 3" Tag="TileWide310x150Text03"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 4" Tag="TileWide310x150Text04"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 5" Tag="TileWide310x150Text05"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 6" Tag="TileWide310x150Text06"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 7" Tag="TileWide310x150Text07"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 8" Tag="TileWide310x150Text08"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 9" Tag="TileWide310x150Text09"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 10" Tag="TileWide310x150Text10"/>
                                            <ComboBoxItem Content="Wide (310x150) Text 11" Tag="TileWide310x150Text11"/>
                                            <ComboBoxItem Content="Square (310x310) Block and Text 1" Tag="TileSquare310x310BlockAndText01"/>
                                            <ComboBoxItem Content="Square (310x310) Block and Text 2" Tag="TileSquare310x310BlockAndText02"/>
                                            <ComboBoxItem Content="Square (310x310) Image" Tag="TileSquare310x310Image"/>
                                            <ComboBoxItem Content="Square (310x310) Image and Text 1" Tag="TileSquare310x310ImageAndText01"/>
                                            <ComboBoxItem Content="Square (310x310) Image and Text 2" Tag="TileSquare310x310ImageAndText02"/>
                                            <ComboBoxItem Content="Square (310x310) Image and Text Overlay 1" Tag="TileSquare310x310ImageAndTextOverlay01"/>
                                            <ComboBoxItem Content="Square (310x310) Image and Text Overlay 2" Tag="TileSquare310x310ImageAndTextOverlay02"/>
                                            <ComboBoxItem Content="Square (310x310) Image and Text Overlay 3" Tag="TileSquare310x310ImageAndTextOverlay03"/>
                                            <ComboBoxItem Content="Square (310x310) Image Collection and Text 1" Tag="TileSquare310x310ImageCollectionAndText01"/>
                                            <ComboBoxItem Content="Square (310x310) Image Collection and Text 2" Tag="TileSquare310x310ImageCollectionAndText02"/>
                                            <ComboBoxItem Content="Square (310x310) Image Collection" Tag="TileSquare310x310ImageCollection"/>
                                            <ComboBoxItem Content="Square (310x310) Small Images and Text List 1" Tag="TileSquare310x310SmallImagesAndTextList01"/>
                                            <ComboBoxItem Content="Square (310x310) Small Images and Text List 2" Tag="TileSquare310x310SmallImagesAndTextList02"/>
                                            <ComboBoxItem Content="Square (310x310) Small Images and Text List 3" Tag="TileSquare310x310SmallImagesAndTextList03"/>
                                            <ComboBoxItem Content="Square (310x310) Small Images and Text List 4" Tag="TileSquare310x310SmallImagesAndTextList04"/>
                                            <ComboBoxItem Content="Square (310x310) Small Images and Text List 5" Tag="TileSquare310x310SmallImagesAndTextList05"/>
                                            <ComboBoxItem Content="Square (310x310) Small Image and Text 1" Tag="TileSquare310x310SmallImageAndText01"/>
                                            <ComboBoxItem Content="Square (310x310) Text 1" Tag="TileSquare310x310Text01"/>
                                            <ComboBoxItem Content="Square (310x310) Text 2" Tag="TileSquare310x310Text02"/>
                                            <ComboBoxItem Content="Square (310x310) Text 3" Tag="TileSquare310x310Text03"/>
                                            <ComboBoxItem Content="Square (310x310) Text 4" Tag="TileSquare310x310Text04"/>
                                            <ComboBoxItem Content="Square (310x310) Text 5" Tag="TileSquare310x310Text05"/>
                                            <ComboBoxItem Content="Square (310x310) Text 6" Tag="TileSquare310x310Text06"/>
                                            <ComboBoxItem Content="Square (310x310) Text 7" Tag="TileSquare310x310Text07"/>
                                            <ComboBoxItem Content="Square (310x310) Text 8" Tag="TileSquare310x310Text08"/>
                                            <ComboBoxItem Content="Square (310x310) Text 9" Tag="TileSquare310x310Text09"/>
                                            <ComboBoxItem Content="Square (310x310) Text List 1" Tag="TileSquare310x310TextList01"/>
                                            <ComboBoxItem Content="Square (310x310) Text List 2" Tag="TileSquare310x310TextList02"/>
                                            <ComboBoxItem Content="Square (310x310) Text List 3" Tag="TileSquare310x310TextList03"/>
                                            <ComboBoxItem Content="Square (71x71) Image" Tag="TileSquare71x71Image"/>
                                            <ComboBoxItem Content="Square (71x71) Icon with Badge" Tag="TileSquare71x71IconWithBadge"/>
                                            <ComboBoxItem Content="Square (150x150) Icon with Badge" Tag="TileSquare150x150IconWithBadge"/>
                                            <ComboBoxItem Content="Wide (310x150) Icon with Badge and Text" Tag="TileWide310x150IconWithBadgeAndText"/>
                                        </ComboBox>

                                        <TextBox Header="Language" Text="{x:Bind Language,Mode=TwoWay}" MinWidth="120"
                                             Grid.Row="1" Margin="0,8,0,0"/>

                                        <ComboBox MinWidth="180" SelectedValuePath="Tag" SelectedValue="{x:Bind Presentation,Mode=TwoWay}"
