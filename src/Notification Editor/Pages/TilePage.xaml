                                                                <ComboBoxItem Content="Caption" Tag="caption"/>
                                                                <ComboBoxItem Content="Caption (subtle)" Tag="captionSubtle"/>
                                                                <ComboBoxItem Content="Body" Tag="body"/>
                                                                <ComboBoxItem Content="Body (subtle)" Tag="bodySubtle"/>
                                                                <ComboBoxItem Content="Base" Tag="base"/>
                                                                <ComboBoxItem Content="Base (subtle)" Tag="baseSubtle"/>
                                                                <ComboBoxItem Content="Subtitle" Tag="subtitle"/>
                                                                <ComboBoxItem Content="Subtitle (subtle)" Tag="subtitleSubtle"/>
                                                                <ComboBoxItem Content="Title" Tag="title"/>
                                                                <ComboBoxItem Content="Title (subtle)" Tag="titleSubtle"/>
                                                                <ComboBoxItem Content="Title (numeral)" Tag="titleNumeral"/>
                                                                <ComboBoxItem Content="Subheader" Tag="subheader"/>
                                                                <ComboBoxItem Content="Subheader (subtle)" Tag="subheaderSubtle"/>
                                                                <ComboBoxItem Content="Subheader (numeral)" Tag="subheaderNumeral"/>
