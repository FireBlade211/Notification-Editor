                                                                    <ComboBoxItem Content="Title (numeral)" Tag="titleNumeral"/>
                                                                    <ComboBoxItem Content="Subheader" Tag="subheader"/>
                                                                    <ComboBoxItem Content="Subheader (subtle)" Tag="subheaderSubtle"/>
                                                                    <ComboBoxItem Content="Subheader (numeral)" Tag="subheaderNumeral"/>
                                                                    <ComboBoxItem Content="Header" Tag="header"/>
