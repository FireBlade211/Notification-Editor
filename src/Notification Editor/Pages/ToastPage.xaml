<Page
    x:Class="FireBlade.NotificationEditor.Pages.ToastPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FireBlade.NotificationEditor.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    xmlns:visualizer="using:NotificationsVisualizerLibrary"
    xmlns:markup="using:FireBlade.NotificationEditor.Markup"
    Loaded="Page_Loaded"
    xmlns:parsing="using:NotificationsVisualizerLibrary.Parsers"
    xmlns:wuxdata="using:Windows.UI.Xaml.Data"
    xmlns:data="using:FireBlade.NotificationEditor.DataModel"
    xmlns:controls="using:FireBlade.NotificationEditor.Controls"
    xmlns:dialogs="using:FireBlade.NotificationEditor.Dialogs">

    <Page.Resources>
        <markup:TypeConfirmConverter x:Key="typeConfirmConverter" />
        <markup:BoolToVisibilityConverter x:Key="boolToVisiblityConverter"/>
        <markup:GroupNameConverter x:Key="groupNameConverter"/>
        <markup:StringToIntConverter x:Key="stringToIntConverter" />

        <CollectionViewSource x:Name="adaptiveGroupsCVS" IsSourceGrouped="True" />
    </Page.Resources>
    
    <Grid x:Name="rootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <RepositionThemeTransition/>
                <EntranceThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        
        <Grid Grid.Column="1" Width="376" x:Name="previewPane" Padding="8,8,8,0"
                    Visibility="{x:Bind showPreviewButton.IsChecked, Mode=OneWay, Converter={StaticResource boolToVisiblityConverter}}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <ComboBox DisplayMemberPath="DisplayString" ItemsSource="{x:Bind Builds}" SelectedValuePath="LongBuildNumber" MinWidth="160"
                      Header="OS Build" x:Name="osBuildCombo" Margin="4,0,4,8" SelectedIndex="0" SelectionChanged="OsBuildCombo_SelectionChanged" />

            <MenuFlyoutSeparator Margin="0,0,0,8" Grid.Row="1" />

            <ScrollViewer Grid.Row="2">
                <StackPanel Margin="8,0,8,8">
                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="Desktop" Margin="4,0,0,2"/>
                    <visualizer:PreviewToast x:Name="desktopToast" Margin="0,0,0,12"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     />


                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="Mobile" Margin="4,0,0,2"/>
                    <visualizer:PreviewToast x:Name="mobileToast" DeviceFamily="Mobile" Margin="0,0,0,12"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     />


                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="Xbox" Margin="4,0,0,2"/>
                    <visualizer:PreviewXboxToast x:Name="xboxToast" Margin="0,0,0,12"
                                     OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"
                                     />

                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="Xbox (Action Center)" Margin="4,0,0,2"/>
                    <visualizer:PreviewXboxToastInActionCenter x:Name="xboxCenterToast"
                                    OSBuildNumber="{x:Bind osBuildCombo.SelectedValue, Mode=OneWay, Converter={StaticResource typeConfirmConverter}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <Pivot Title="TOAST NOTIFICATION EDITOR">
            <Pivot.RightHeader>
                <!-- HACK: SplitButton was not in 10240, so we improvize -->
                <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Content="Send" Width="64" Height="32" Margin="0,0,2,0" x:Name="sendButton" Click="SendButton_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="&#xE70D;" FontFamily="{StaticResource SymbolThemeFontFamily}" Height="32">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Schedule" x:Name="scheduleButton" Click="ScheduleButton_Click"/>
                                <MenuFlyoutItem Text="Cancel Scheduled" x:Name="cancelScheduledBtn" Click="CancelScheduledBtn_Click"
                                                IsEnabled="False"/>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem Text="Show preview" x:Name="showPreviewButton" IsChecked="True"
                                                      Click="ShowPreviewButton_Click"/>
                                <MenuFlyoutItem Text="Share" x:Name="shareButton" Click="ShareButton_Click">
                                    <!--
                                    <MenuFlyoutItem.Command>
                                        <StandardUICommand Kind="Share"/>
                                    </MenuFlyoutItem.Command>
                                    -->
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Save" x:Name="saveButton" Click="SaveButton_Click">
                                    <!--
                                    <MenuFlyoutItem.Command>
                                        <StandardUICommand Kind="Save"/>
                                    </MenuFlyoutItem.Command>
                                    -->
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Save as..." x:Name="saveAsButton" Click="SaveAsButton_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Pivot.RightHeader>
            
            <PivotItem Header="Home">
                <ScrollViewer>
                    <StackPanel Margin="8,4,8,0">
                        <TextBox Header="Launch arguments" x:Name="launchBox" LostFocus="LaunchBox_LostFocus" />

                        <ComboBox Header="Display duration" Margin="0,16,0,0" HorizontalAlignment="Stretch" SelectedValuePath="Tag"
                                  x:Name="durationCombo" SelectionChanged="DurationCombo_SelectionChanged">
                            <ComboBoxItem Content="Default" Tag=""/>
                            <ComboBoxItem Content="Long" Tag="long"/>
                            <ComboBoxItem Content="Short" Tag="short"/>
                        </ComboBox>

                        <TextBlock Text="Display Timestamp (Creators Update and newer)" Margin="0,16,0,0"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <ToggleSwitch x:Name="timestampCheck" Toggled="TimestampCheck_Toggled" />
                            <DatePicker Margin="0,0,8,0" IsEnabled="{x:Bind timestampCheck.IsOn, Mode=OneWay}"
                                        DateChanged="TimestampDatePicker_DateChanged" Grid.Column="1"
                                        HorizontalAlignment="Stretch" x:Name="timestampDatePicker" />

                            <TimePicker IsEnabled="{x:Bind timestampCheck.IsOn, Mode=OneWay}" x:Name="timestampTimePicker"
                                        Grid.Column="2" HorizontalAlignment="Stretch" TimeChanged="TimestampTimePicker_TimeChanged"/>
                        </Grid>

                        <ComboBox Header="Scenario" Margin="0,16,0,0" HorizontalAlignment="Stretch" SelectedValuePath="Tag"
                                  x:Name="scenarioBox" SelectionChanged="ScenarioBox_SelectionChanged">
                            <ComboBoxItem Content="None" Tag=""/>
                            <ComboBoxItem Content="Reminder" Tag="reminder"/>
                            <ComboBoxItem Content="Alarm" Tag="alarm"/>
                            <ComboBoxItem Content="Incoming Call" Tag="incomingCall"/>
                            <ComboBoxItem Content="Urgent" Tag="urgent"/>
                        </ComboBox>

                        <ToggleSwitch Margin="0,16,0,0" OnContent="Enable button styles (Windows 11)" OffContent="Enable button styles (Windows 11)"
                                      x:Name="buttonStylesToggle" Toggled="ButtonStylesToggle_Toggled"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Audio">
                <ScrollViewer>
                    <StackPanel>
                        <ToggleSwitch OffContent="Use default audio" OnContent="Use default audio" x:Name="useAudioSwitch" IsOn="True"
                                      Toggled="UseAudioSwitch_Toggled"/>

                        <TextBlock Text="Mode" Margin="0,8,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Content="Built-in:" IsChecked="True" VerticalAlignment="Bottom" x:Name="defaultSoundRadio"
                                         IsEnabled="{x:Bind useAudioSwitch.IsOn,Mode=OneWay,Converter={StaticResource boolNegationConverter}}"
                                         Checked="DefaultSoundRadio_Checked" Unchecked="DefaultSoundRadio_Checked"/>

                            <ComboBox HorizontalAlignment="Stretch" Margin="0,8,0,0" SelectedValuePath="Tag" SelectedIndex="0"
                                  IsEnabled="{x:Bind useAudioSwitch.IsOn,Mode=OneWay,Converter={StaticResource boolNegationConverter}}"
                                  Grid.Column="1" x:Name="defaultSoundBox" SelectionChanged="DefaultSoundBox_SelectionChanged">

                                <ComboBoxItem Content="None" Tag=""/>
                                <ComboBoxItem Content="Default" Tag="ms-winsoundevent:Notification.Default"/>
                                <ComboBoxItem Content="Instant Messaging (IM)" Tag="ms-winsoundevent:Notification.IM"/>
                                <ComboBoxItem Content="Mail" Tag="ms-winsoundevent:Notification.Mail"/>
                                <ComboBoxItem Content="Reminder" Tag="ms-winsoundevent:Notification.Reminder"/>
                                <ComboBoxItem Content="SMS" Tag="ms-winsoundevent:Notification.SMS"/>
                                <ComboBoxItem Content="Alarm 1 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm"/>
                                <ComboBoxItem Content="Alarm 2 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm2"/>
                                <ComboBoxItem Content="Alarm 3 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm3"/>
                                <ComboBoxItem Content="Alarm 4 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm4"/>
                                <ComboBoxItem Content="Alarm 5 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm5"/>
                                <ComboBoxItem Content="Alarm 6 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm6"/>
                                <ComboBoxItem Content="Alarm 7 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm7"/>
                                <ComboBoxItem Content="Alarm 8 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm8"/>
                                <ComboBoxItem Content="Alarm 9 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm9"/>
                                <ComboBoxItem Content="Alarm 10 (looping)" Tag="ms-winsoundevent:Notification.Looping.Alarm10"/>
                                <ComboBoxItem Content="Incoming Call 1 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call"/>
                                <ComboBoxItem Content="Incoming Call 2 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call2"/>
                                <ComboBoxItem Content="Incoming Call 3 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call3"/>
                                <ComboBoxItem Content="Incoming Call 4 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call4"/>
                                <ComboBoxItem Content="Incoming Call 5 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call5"/>
                                <ComboBoxItem Content="Incoming Call 6 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call6"/>
                                <ComboBoxItem Content="Incoming Call 7 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call7"/>
                                <ComboBoxItem Content="Incoming Call 8 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call8"/>
                                <ComboBoxItem Content="Incoming Call 9 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call9"/>
                                <ComboBoxItem Content="Incoming Call 10 (looping)" Tag="ms-winsoundevent:Notification.Looping.Call10"/>

                            </ComboBox>
                        </Grid>
                        <Grid ToolTipService.ToolTip="Requires Windows 10, version 1511 or later">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Content="Custom:" VerticalAlignment="Bottom" x:Name="customSoundRadio" Checked="CustomSoundRadio_Checked"
                                         IsEnabled="{x:Bind useAudioSwitch.IsOn,Mode=OneWay,Converter={StaticResource boolNegationConverter}}"
                                         Unchecked="CustomSoundRadio_Checked"/>

                            <TextBox Margin="0,8,0,0" Grid.Column="1" PlaceholderText="URI..." x:Name="customSoundUriBox"
                                     LostFocus="CustomSoundUriBox_LostFocus"/>
                        </Grid>

                        <ToggleSwitch Header="Loop" Margin="0,8,0,0" x:Name="loopAudioSwitch" Toggled="LoopAudioSwitch_Toggled"
                                      IsEnabled="{x:Bind useAudioSwitch.IsOn,Mode=OneWay,Converter={StaticResource boolNegationConverter}}"/>

                        <TextBlock TextWrapping="WrapWholeWords" Margin="0,4,0,0">
                            <Bold>WARNING:</Bold> In order to loop audio, make sure that <Bold>Display Duration</Bold> is
                            not set to <Bold>Default</Bold> in the <Bold>Home</Bold> tab.
                        </TextBlock>

                        <ToggleSwitch Header="Silent" Margin="0,12,0,0" x:Name="audioSilentSwitch" Toggled="AudioSilentSwitch_Toggled"
                                      IsEnabled="{x:Bind useAudioSwitch.IsOn,Mode=OneWay,Converter={StaticResource boolNegationConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
            
            <PivotItem Header="Visual">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel>
                        <!-- USELESS COMBO BOX -->
                        <ComboBox Header="Binding Template" SelectedIndex="0">
                            <ComboBoxItem Content="Toast Generic" />
                        </ComboBox>

                        <ToggleSwitch OffContent="Append query to image URIs" x:Name="addQueryToggle" OnContent="{x:Bind addQueryToggle.OffContent}"
                                  Margin="0,8,0,0" Toggled="AddQueryToggle_Toggled"/>

                        <TextBox Header="Base URI" x:Name="baseUriBox" LostFocus="BaseUriBox_LostFocus" Margin="0,8,0,0"
                             IsSpellCheckEnabled="False"/>

                        <TextBox Header="Locale" PlaceholderText="e.g, en-US" Margin="0,8,0,0" x:Name="localeBox" LostFocus="LocaleBox_LostFocus"
                             IsSpellCheckEnabled="False"/>
                    </StackPanel>

                </Grid>
            </PivotItem>

            <PivotItem Header="Content">
                <Grid Margin="0,9,0,-1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add text" Click="Button_Click_3"/>
                        <Button Content="Add image" Margin="4,0,0,0" Click="Button_Click_1"/>
                        <Button Content="Add progress bar" Margin="4,0,0,0" Click="Button_Click_2"/>
                    </StackPanel>

                    <ListView Grid.Row="1" SelectionMode="None" ItemsSource="{x:Bind ToastContent,Mode=OneWay}"
                              Margin="0,8" CanDragItems="True" DragItemsCompleted="ContentListView_DragItemsCompleted"
                              CanReorderItems="True" AllowDrop="True">
                        <ListView.ItemTemplateSelector>
                            <markup:ToastElementTemplateSelector>
                                <markup:ToastElementTemplateSelector.ToastTextTemplate>
                                    <DataTemplate x:DataType="data:ToastText">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.ColumnSpan="4">
                                                <SymbolIcon Symbol="Font"/>
                                                <TextBlock Text="Text" Margin="8,0,0,0" Style="{StaticResource BaseTextBlockStyle}"/>
                                            </StackPanel>

                                            <TextBox Header="ID" InputScope="Number" Grid.Row="1"
                                                     Text="{x:Bind Id, Mode=TwoWay,Converter={StaticResource stringToIntConverter}}"/>

                                            <TextBox Header="Text" Grid.Row="1" Grid.Column="1" Text="{x:Bind Text,Mode=TwoWay}" MinWidth="180"
                                                     Margin="8,0,0,0" MaxWidth="360"/>

                                            <ComboBox Header="Placement" ToolTipService.ToolTip="Anniversary Update and later"
                                                      Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" SelectedValuePath="Tag"
                                                      SelectedValue="{x:Bind Placement, Mode=TwoWay}" MinWidth="120">
                                                <ComboBoxItem Content="Normal" Tag=""/>
                                                <ComboBoxItem Content="Attribution" Tag="attribution"/>
                                            </ComboBox>

                                            <ToggleSwitch Header="Center align (Incoming Call scenario)" Grid.Row="1" Margin="8,0,0,0"
                                                          IsOn="{x:Bind CallScenarioCenterAlign,Mode=TwoWay}" Grid.Column="3"/>

                                            <Button Content="Remove" Style="{StaticResource DeleteButtonStyle}" Grid.Row="2"
                                                    Tag="{x:Bind}" Click="RemoveToastElementButton_Click" Margin="0,8,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </markup:ToastElementTemplateSelector.ToastTextTemplate>
                                <markup:ToastElementTemplateSelector.ToastImageTemplate>
                                    <DataTemplate x:DataType="data:ToastImage">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.ColumnSpan="6">
                                                <SymbolIcon Symbol="Pictures"/>
                                                <TextBlock Text="Image" Margin="8,0,0,0" Style="{StaticResource BaseTextBlockStyle}"/>
                                            </StackPanel>

                                            <TextBox Header="ID" InputScope="Number" Grid.Row="1"
                                                     Text="{x:Bind Id, Mode=TwoWay,Converter={StaticResource stringToIntConverter}}"/>

                                            <TextBox Header="Image Source URI" Grid.Row="1" MinWidth="180" Margin="8,0,0,0"
                                                     Text="{x:Bind Src,Mode=TwoWay}" Grid.Column="1" MaxWidth="360"/>

                                            <Button Grid.Row="1" Grid.Column="2" Click="BrowseAssetsButton_Click" VerticalAlignment="Bottom"
                                                    Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Browse assets"
                                                    Height="32">
                                                
                                                <FontIcon Glyph="&#xF12B;"/>

                                                <Button.Tag>
                                                    <dialogs:ImageBrowserDialog SelectedUri="{x:Bind Src,Mode=TwoWay}" />
                                                </Button.Tag>
                                            </Button>

                                            <TextBox Header="Alternative text" Grid.Row="1" Grid.Column="3"
                                                     Margin="8,0,0,0" Text="{x:Bind Alt,Mode=TwoWay}"/>

                                            <ComboBox Header="Crop" Margin="8,0,0,0" Grid.Row="1"
                                                      Grid.Column="4" SelectedValuePath="Tag"
                                                      SelectedValue="{x:Bind Crop,Mode=TwoWay}">
                                                <ComboBoxItem Content="None" Tag=""/>
                                                <ComboBoxItem Content="Circle" Tag="circle"/>
                                            </ComboBox>

                                            <ComboBox Header="Placement" Margin="8,0,0,0" Grid.Row="1" Grid.Column="5"
                                                      SelectedValuePath="Tag" SelectedValue="{x:Bind Placement,Mode=TwoWay}">
                                                <ComboBoxItem Content="Inline (default)" Tag=""/>
                                                <ComboBoxItem Content="Hero" Tag="hero"/>
                                                <ComboBoxItem Content="App logo override" Tag="appLogoOverride"/>
                                            </ComboBox>
                                            
                                            <CheckBox IsThreeState="True" Content="Append URI query" IsChecked="{x:Bind AddQuery,Mode=TwoWay}"
                                                      Grid.Row="1" Grid.Column="6" Margin="8,0,0,0" VerticalAlignment="Bottom"/>

                                            <Button Content="Remove" Style="{StaticResource DeleteButtonStyle}" Grid.Row="2"
                                                    Tag="{x:Bind}" Click="RemoveToastElementButton_Click" Margin="0,8,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </markup:ToastElementTemplateSelector.ToastImageTemplate>
                                <markup:ToastElementTemplateSelector.ToastProgressTemplate>
                                    <DataTemplate x:DataType="data:ToastProgress">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <FontIcon Glyph="&#xF16A;"/>
                                                <TextBlock Text="Progress Bar" Margin="8,0,0,0" Style="{StaticResource BaseTextBlockStyle}"/>
                                            </StackPanel>

                                            <TextBox Text="{x:Bind Title,Mode=TwoWay}" Header="Title" Grid.Row="1" MinWidth="180"/>
                                            <TextBox Text="{x:Bind Status,Mode=TwoWay}" Header="Status" Grid.Row="1" MinWidth="100"
                                                     Grid.Column="1" Margin="8,0,0,0" />
                                            <ToggleSwitch OffContent="Determinate" OnContent="Indeterminate" Header="Mode" Margin="12,0,0,0"
                                                          IsOn="{x:Bind Indeterminate,Mode=TwoWay}" Grid.Row="1" Grid.Column="2"
                                                          IsEnabled="{x:Bind ValueBind,Mode=OneWay,Converter={StaticResource stringBoolConverter},ConverterParameter=True}"/>
                                            <controls:CommitSlider CommittedValue="{x:Bind Value,Mode=TwoWay}" Grid.Row="1" Grid.Column="3"
                                                                   IsEnabled="{x:Bind CanEditValue,Mode=OneWay}"
                                                                   Margin="8,0,0,0" Header="Value" MinWidth="180" Minimum="0" Maximum="100"/>
                                            <Button Margin="8,0,0,0" ToolTipService.ToolTip="Bind to notification data"
                                                    Grid.Row="1" Grid.Column="4" VerticalAlignment="Bottom"
                                                    Style="{x:Bind ValueBind,Mode=OneWay,Converter={StaticResource stringButtonStyleConverter}}">
                                                <SymbolIcon Symbol="Link"/>

                                                <Button.Flyout>
                                                    <Flyout>
                                                        <ListView SelectionMode="Single" ItemsSource="{x:Bind Page.DataItems,Mode=OneWay}"
                                                                  SelectedValuePath="Key" SelectedValue="{x:Bind ValueBind,Mode=TwoWay}">
                                                            <ListView.Header>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                    <TextBlock Text="Bind to notification data" Style="{StaticResource BaseTextBlockStyle}"
                                                                               VerticalAlignment="Center"/>
                                                                    <Button Content="&#xE711;" Margin="8,0,0,0" Tag="{x:Bind}"
                                                                            x:Name="clearProgressBindButton" Click="ClearProgressBindButton_Click"
                                                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                            Style="{StaticResource SubtleButtonStyle}"
                                                                            ToolTipService.ToolTip="Remove binding"
                                                                            IsEnabled="{x:Bind ValueBind,Mode=OneWay,Converter={StaticResource stringBoolConverter}}"/>
                                                                </StackPanel>
                                                            </ListView.Header>

                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="data:NotificationDataItem">
                                                                    <TextBlock Text="{x:Bind Key,Mode=OneWay}"
                                                                               ToolTipService.ToolTip="{x:Bind Value,Mode=OneWay}"/>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <TextBox Text="{x:Bind ValueStringOverride,Mode=TwoWay}" MinWidth="180"
                                                      Margin="16,0,0,0" Grid.Row="1" Grid.Column="5" Header="Value string override"/>


                                            <Button Content="Remove" Style="{StaticResource DeleteButtonStyle}" Grid.Row="2"
                                                    Tag="{x:Bind}" Click="RemoveToastElementButton_Click" Margin="0,8,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </markup:ToastElementTemplateSelector.ToastProgressTemplate>
                            </markup:ToastElementTemplateSelector>
                        </ListView.ItemTemplateSelector>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Adaptive">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{ThemeResource SecondaryBackgroundBrush}" Grid.Column="1" Grid.RowSpan="4"/>

                    <TextBlock Style="{StaticResource SubheaderTextBlockStyle}" Text="Groups"/>

                    <TextBlock TextWrapping="WrapWholeWords" Grid.Row="1"><Bold>Adaptive</Bold> enables complex layouts that adapt to different screen
                        resolutions within your tiles and toasts (as of the 1607 <Bold>Anniversary Update</Bold>). Click the button below to add
                        a group via <Bold>Adaptive</Bold>. <Hyperlink NavigateUri="https://learn.microsoft.com/windows/uwp/launch-resume/create-adaptive-tiles">
                            Learn more about Adaptive.</Hyperlink>
                    </TextBlock>

                    <Button Grid.Row="2" Content="Add group" Margin="0,8,0,0" x:Name="addAdaptiveGroupButton"
                            Click="AddAdaptiveGroupButton_Click"/>

                    <GridView Grid.Row="3" Margin="0,8,0,0" ItemsSource="{x:Bind adaptiveGroupsCVS.View, Mode=OneWay}" x:Name="adaptiveGroupsGV"
                              SelectedValuePath="Elements">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="data:AdaptiveSubgroup">
                                <Grid Width="120" Height="140" Padding="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock TextWrapping="WrapWholeWords" Text="{x:Bind Name}" HorizontalAlignment="Left"
                                               VerticalAlignment="Top" TextTrimming="CharacterEllipsis" Grid.ColumnSpan="2" />
                                    <Button Grid.Row="1" Content="Remove" Style="{StaticResource DeleteButtonStyle}"
                                            Click="Button_Click" Tag="{x:Bind}"/>

                                    <Button Grid.Row="1" Grid.Column="1" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="More options"
                                            Content="&#xE712;" FontFamily="{StaticResource SymbolThemeFontFamily}" HorizontalAlignment="Right"
                                            Background="Transparent">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="Subgroup options"/>

                                                    <!-- Note: We have to use a TextBox instead of a slider because UpdateSourceTrigger wasn't in 10240 -->
                                                    <TextBox Header="Weight (%)" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                             Text="{x:Bind Weight,Mode=TwoWay,Converter={StaticResource stringToIntConverter}}">
                                                        <ToolTipService.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock TextWrapping="WrapWholeWords">
                                                                    <Bold>Specify the relative percentage of space this subgroup takes up relative to other subgroups.</Bold>
                                                                    <LineBreak/>Specify <Italic>-1</Italic> to use remaining space.
                                                                </TextBlock>
                                                            </ToolTip>
                                                        </ToolTipService.ToolTip>
                                                    
                                                    </TextBox>

                                                    <ComboBox Header="Text stacking" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                              SelectedValuePath="Tag" SelectedValue="{x:Bind TextStacking,Mode=TwoWay}">
                                                        <ComboBoxItem Content="Default" Tag=""/>
                                                        <ComboBoxItem Content="Top" Tag="top"/>
                                                        <ComboBoxItem Content="Center" Tag="center"/>
                                                        <ComboBoxItem Content="Bottom" Tag="bottom"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>

                        <GridView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="data:AdaptiveGroup">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource ApplicationForegroundThemeBrush}" Style="{StaticResource SubtitleTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch"/>

                                            <Button Content="Add subgroup" Grid.Column="1" Tag="{x:Bind}" x:Name="addSubgroupBtn" Click="AddSubgroupBtn_Click" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                            <Button Content="Remove" Grid.Column="2" Tag="{x:Bind}" x:Name="removeSubgroupBtn" Click="RemoveSubgroupBtn_Click" HorizontalAlignment="Right"
                                                    Style="{StaticResource DeleteButtonStyle}"/>
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>

                                <GroupStyle.HeaderContainerStyle>
                                    <Style TargetType="GridViewHeaderItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </Style>
                                </GroupStyle.HeaderContainerStyle>
                            </GroupStyle>
                        </GridView.GroupStyle>
                    </GridView>

                    <TextBlock Style="{StaticResource SubheaderTextBlockStyle}" Grid.Column="1" Text="Content" TextTrimming="WordEllipsis"
                               Margin="8,0,0,0"/>

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Add text"  Margin="8,0,0,0" x:Name="addTextButton"  Click="AddTextButton_Click" />
                        <Button Content="Add image" Margin="8,0,0,0" x:Name="addImageButton" Click="AddImageButton_Click"/>
                    </StackPanel>

                    <ListView Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" ItemsSource="{x:Bind adaptiveGroupsGV.SelectedValue, Mode=OneWay}"
                              SelectionMode="None" HorizontalContentAlignment="Stretch" CanDragItems="True" DragItemsCompleted="ListView_DragItemsCompleted"
                              CanReorderItems="True" AllowDrop="True">
                        
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplateSelector>
                            <markup:AdaptiveElementTemplateSelector>
                                <markup:AdaptiveElementTemplateSelector.TextTemplate>
                                    <DataTemplate x:DataType="data:AdaptiveText">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <SymbolIcon Symbol="Font" VerticalAlignment="Bottom" Margin="0,0,8,8"
                                                        ToolTipService.ToolTip="Text"/>

                                            <TextBox Header="ID" InputScope="Number" Grid.Column="1"
                                                     Text="{x:Bind Id, Mode=TwoWay,Converter={StaticResource stringToIntConverter}}"/>

                                            <TextBox Header="Text" Margin="8,0,8,0" Text="{x:Bind Text, Mode=TwoWay}"
                                                     Grid.Column="2" HorizontalAlignment="Stretch" />

                                            <Button Content="&#xE712;" FontFamily="{StaticResource SymbolThemeFontFamily}" Grid.Column="3"
                                                    Width="32" Height="32" Padding="0" ToolTipService.ToolTip="More options" VerticalAlignment="Bottom">
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel MinWidth="180">
                                                            <TextBlock Text="More text options" Style="{StaticResource BaseTextBlockStyle}"/>

                                                            <TextBox Header="Language" PlaceholderText="e.g, en-US" Margin="0,8,0,0"
                                                                     Text="{x:Bind Language,Mode=TwoWay}"/>
       
                                                            <ComboBox Header="Style" Margin="0,8,0,0" SelectedValuePath="Tag"
                                                                      SelectedValue="{x:Bind Style,Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                                <ComboBoxItem Content="Default" Tag=""/>
                                                                <ComboBoxItem Content="Caption" Tag="caption"/>
                                                                <ComboBoxItem Content="Caption (subtle)" Tag="captionSubtle"/>
                                                                <ComboBoxItem Content="Body" Tag="body"/>
                                                                <ComboBoxItem Content="Body (subtle)" Tag="bodySubtle"/>
                                                                <ComboBoxItem Content="Base" Tag="base"/>
                                                                <ComboBoxItem Content="Base (subtle)" Tag="baseSubtle"/>
                                                                <ComboBoxItem Content="Subtitle" Tag="subtitle"/>
                                                                <ComboBoxItem Content="Subtitle (subtle)" Tag="subtitleSubtle"/>
                                                                <ComboBoxItem Content="Title" Tag="title"/>
                                                                <ComboBoxItem Content="Title (subtle)" Tag="titleSubtle"/>
                                                                <ComboBoxItem Content="Title (numeral)" Tag="titleNumeral"/>
                                                                <ComboBoxItem Content="Subheader" Tag="subheader"/>
                                                                <ComboBoxItem Content="Subheader (subtle)" Tag="subheaderSubtle"/>
                                                                <ComboBoxItem Content="Subheader (numeral)" Tag="subheaderNumeral"/>
                                                                <ComboBoxItem Content="Header" Tag="header"/>
                                                                <ComboBoxItem Content="Header (subtle)" Tag="headerSubtle"/>
                                                                <ComboBoxItem Content="Header (numeral)" Tag="headerNumeral"/>
                                                            </ComboBox>

                                                            <ToggleSwitch Margin="0,8,0,0" OffContent="Wrap" OnContent="Wrap"
                                                                          IsOn="{x:Bind Wrap,Mode=TwoWay}" />

                                                            <TextBlock Text="Lines" Margin="0,8,0,0"/>
                                                            <TextBlock Text="Specify -1 to use none" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,8"/>

                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox PlaceholderText="Min" InputScope="Number"
                                                                         Text="{x:Bind MinLines,Mode=TwoWay,Converter={StaticResource stringToIntConverter}}"/>
                                                                <TextBlock Text="-" Margin="8,0" VerticalAlignment="Center"/>
                                                                <TextBox PlaceholderText="Max" InputScope="Number"
                                                                         Text="{x:Bind MaxLines,Mode=TwoWay,Converter={StaticResource stringToIntConverter}}"/>
                                                            </StackPanel>

                                                            <ComboBox Header="Alignment" SelectedValuePath="Tag" Margin="0,8,0,0"
                                                                      SelectedValue="{x:Bind Align, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                                <ComboBoxItem Content="Default" Tag=""/>
                                                                <ComboBoxItem Content="Left" Tag="left"/>
                                                                <ComboBoxItem Content="Center" Tag="center"/>
                                                                <ComboBoxItem Content="Right" Tag="right"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            
                                            </Button>

                                            <Button Content="Remove" Style="{StaticResource DeleteButtonStyle}" Margin="8,0,0,0"
                                                    Tag="{x:Bind}" Click="RemoveElementButton_Click" Grid.Column="4" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </DataTemplate>
                                </markup:AdaptiveElementTemplateSelector.TextTemplate>
                                <markup:AdaptiveElementTemplateSelector.ImageTemplate>
                                    <DataTemplate x:DataType="data:AdaptiveImage">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon Glyph="&#xEB9F;" VerticalAlignment="Bottom" Margin="0,0,8,8"
                                                      ToolTipService.ToolTip="Image"/>
                                            
                                            <TextBox Header="ID" InputScope="Number" Grid.Column="1"
                                                     Text="{x:Bind Id, Mode=TwoWay,Converter={StaticResource stringToIntConverter}}"/>

                                            <TextBox Header="Image Source" Margin="8,0,0,0" Text="{x:Bind Src, Mode=TwoWay}"
                                                     Grid.Column="2" HorizontalAlignment="Stretch" />

                                            <Button Grid.Row="1" Grid.Column="3" Click="BrowseAssetsButton_Click" VerticalAlignment="Bottom"
                                                    Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Browse assets"
                                                    Height="32" Margin="0,0,8,0">

                                                <FontIcon Glyph="&#xF12B;"/>

                                                <Button.Tag>
                                                    <dialogs:ImageBrowserDialog SelectedUri="{x:Bind Src,Mode=TwoWay}" />
                                                </Button.Tag>
                                            </Button>

                                            <Button Content="&#xE712;" FontFamily="{StaticResource SymbolThemeFontFamily}" Grid.Column="4"
                                                    Width="32" Height="32" Padding="0" ToolTipService.ToolTip="More options" VerticalAlignment="Bottom">
                                                <Button.Flyout>
                                                    <Flyout>
                                                        <StackPanel MinWidth="180">
                                                            <TextBlock Text="More image options" Style="{StaticResource BaseTextBlockStyle}"/>

                                                            <TextBox Header="Alternative text" Text="{x:Bind Alt,Mode=TwoWay}"
                                                                     Margin="0,8,0,0" />

                                                            <CheckBox Content="Append URL query" IsChecked="{x:Bind AddQuery, Mode=TwoWay}"
                                                                      Margin="0,8,0,0" IsThreeState="True"/>

                                                            <ComboBox Header="Crop" Margin="0,8,0,0" SelectedValuePath="Tag"
                                                                      SelectedValue="{x:Bind Crop,Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                                <ComboBoxItem Content="Default" Tag=""/>
                                                                <ComboBoxItem Content="None" Tag="none"/>
                                                                <ComboBoxItem Content="Circle" Tag="circle"/>
                                                            </ComboBox>

                                                            <ToggleSwitch OffContent="Remove margin" OnContent="Remove margin"
                                                                          Margin="0,8,0,0" IsOn="{x:Bind RemoveMargin,Mode=TwoWay}"/>

                                                            <ComboBox Margin="0,8,0,0" Header="Alignment" HorizontalAlignment="Stretch"
                                                                      SelectedValuePath="Tag" SelectedValue="{x:Bind Align,Mode=TwoWay}">
                                                                <ComboBoxItem Content="Default" Tag=""/>
                                                                <ComboBoxItem Content="Stretch" Tag="stretch"/>
                                                                <ComboBoxItem Content="Left" Tag="left"/>
                                                                <ComboBoxItem Content="Center" Tag="center"/>
                                                                <ComboBoxItem Content="Right" Tag="right"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>

                                            </Button>

                                            <Button Content="Remove" Style="{StaticResource DeleteButtonStyle}" Margin="8,0,0,0"
                                                    Tag="{x:Bind}" Click="RemoveElementButton_Click" Grid.Column="5" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </DataTemplate>
                                </markup:AdaptiveElementTemplateSelector.ImageTemplate>
                            </markup:AdaptiveElementTemplateSelector>
                        </ListView.ItemTemplateSelector>
                    </ListView>
                </Grid>
            </PivotItem>
            
            <PivotItem Header="Actions">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <CheckBox Content="Use snooze/dismiss system commands (cannot be combined with other actions or inputs)"
                              x:Name="snoozeDismissCheck" Checked="SnoozeDismissCheck_Checked" Unchecked="SnoozeDismissCheck_Checked"/>

                    <Button Margin="0,0,0,0" Content="Add action" Grid.Row="1"
                            x:Name="addActionBtn" Click="AddActionBtn_Click" />

                    <ListView Grid.Row="2" ItemsSource="{x:Bind Actions, Mode=OneWay}" SelectionMode="None" Margin="0,16,0,0"
                              x:Name="actionsLv" DragItemsCompleted="ActionsLv_DragItemsCompleted" CanDragItems="True"
                              CanReorderItems="True" AllowDrop="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="data:ToastAction">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBox Header="Content (required)" Text="{x:Bind Content, Mode=TwoWay}"
                                                 MinWidth="180" Margin="0,0,0,4" />
                                        
                                        <TextBox Header="Arguments (required)" Text="{x:Bind Args,Mode=TwoWay}"
                                                 MinWidth="180" Margin="0,0,0,4" Grid.Row="1" />
                                        
                                        <TextBox Header="Type" Text="{x:Bind Type, Mode=TwoWay}"
                                                 MinWidth="180" Margin="0,0,0,4" Grid.Row="2" />

                                        <ComboBox Header="Activation type" Margin="8,0,0,4" Grid.Column="1" SelectedValuePath="Tag"
                                                  SelectedValue="{x:Bind ActivationType, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Foreground" Tag="foreground" IsSelected="True" />
                                            <ComboBoxItem Content="Background" Tag="background" />
                                            <ComboBoxItem Content="Protocol" Tag="protocol" />
                                        </ComboBox>

                                        <ComboBox Header="After activation behavior" Margin="8,0,0,4" Grid.Column="1" Grid.Row="1"
                                                  SelectedValuePath="Tag" SelectedValue="{x:Bind AfterActivationBehavior, Mode=TwoWay}">
                                            <ComboBoxItem Content="Default" Tag="default" />
                                            <ComboBoxItem Content="Pending Update" Tag="pendingUpdate" />
                                        </ComboBox>

                                        <ComboBox Header="Placement" Margin="8,0,0,4" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch"
                                                  SelectedValuePath="Tag" SelectedValue="{x:Bind Placement, Mode=TwoWay}">
                                            <ComboBoxItem Content="Inline" Tag=""/>
                                            <ComboBoxItem Content="Context menu" Tag="contextMenu"/>
                                        </ComboBox>

                                        <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="8,0,0,4">
                                            <TextBox Header="Image URI" Text="{x:Bind ImageUri, Mode=TwoWay}"
                                                     MinWidth="120" />

                                            <Button Click="BrowseAssetsButton_Click" VerticalAlignment="Bottom" Height="32" Margin="0,0,8,0"
                                                    Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Browse assets">

                                                <FontIcon Glyph="&#xF12B;"/>

                                                <Button.Tag>
                                                    <dialogs:ImageBrowserDialog SelectedUri="{x:Bind ImageUri,Mode=TwoWay}" />
                                                </Button.Tag>
                                            </Button>
                                        </StackPanel>

                                        <ComboBox Header="Input" MinWidth="164" Grid.Column="3" ItemsSource="{x:Bind Page.InputOptions,Mode=OneWay}"
                                                  SelectedValuePath="Id" SelectedValue="{x:Bind InputId, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayString" x:Name="inputCombo"/>

                                        <!--
                                        <Button Grid.Column="4" Width="32" Height="32" Padding="0" Background="Transparent" VerticalAlignment="Bottom"
                                                Margin="0,0,0,4" ToolTipService.ToolTip="Clear" Tag="{Binding ElementName=inputCombo}"
                                                x:Name="clearButton" Click="ClearButton_Click">
                                            <Viewbox Width="16" Height="16">
                                                <SymbolIcon Symbol="Cancel"/>
                                            </Viewbox>
                                        </Button>
                                        -->

                                        <!--
                                        <AppBarButton Label="Hints" Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Margin="8,0,0,4">
                                            <AppBarButton.Icon>
                                                <FontIcon Glyph="&#xEA80;"/>
                                            </AppBarButton.Icon>

                                            <AppBarButton.Flyout>
                                                <Flyout Placement="Top">
                                                    <StackPanel>
                                                        <ComboBox Header="Button Style" SelectedValuePath="Tag"
                                                                  SelectedValue="{x:Bind ButtonStyle,Mode=TwoWay}">

                                                            <ComboBoxItem Content="Default" Tag=""/>
                                                            <ComboBoxItem Content="Success" Tag="Success"/>
                                                            <ComboBoxItem Content="Critical (error)" Tag="Critical"/>

                                                        </ComboBox>

                                                        <TextBlock TextWrapping="WrapWholeWords" MaxWidth="360" Margin="0,8,0,0">
                                                            <Bold>NOTE:</Bold> Button styles are only supported on Windows 11. You must enable
                                                            Use Button Styles on the Home tab. Button styles are not supported in the preview.
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Flyout>
                                            </AppBarButton.Flyout>
                                        </AppBarButton>
                                        -->

                                        <ComboBox Header="Button Style" SelectedValuePath="Tag" Grid.Row="1" Grid.Column="2"
                                                  SelectedValue="{x:Bind ButtonStyle,Mode=TwoWay}" Margin="8,0,0,4"
                                                  HorizontalAlignment="Stretch">

                                            <ComboBoxItem Content="Default" Tag=""/>
                                            <ComboBoxItem Content="Success" Tag="Success"/>
                                            <ComboBoxItem Content="Critical (error)" Tag="Critical"/>

                                        </ComboBox>

                                        <TextBox Header="Tooltip" Grid.Column="2" Grid.Row="2"
                                                 Text="{x:Bind ToolTip, Mode=TwoWay}" Margin="8,0,0,4"/>
                                    </Grid>

                                    <Button Content="Remove" Margin="0,8,0,0" x:Name="removeActionBtn"
                                            Tag="{x:Bind}" Click="RemoveActionBtn_Click" Style="{StaticResource DeleteButtonStyle}" />
                                    
                                    <MenuFlyoutSeparator Margin="0,8" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Inputs">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Margin="0,0,0,0" Content="Add input"
                            x:Name="addInputBtn" Click="AddInputBtn_Click" />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind Inputs, Mode=OneWay}" SelectionMode="None" Margin="0,16,0,0"
                              x:Name="inputsLv" DragItemsCompleted="InputsLv_DragItemsCompleted" CanDragItems="True"
                              CanReorderItems="True" AllowDrop="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="data:ToastInput">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Header="ID" MinWidth="120" Text="{x:Bind Id, Mode=TwoWay}" Margin="0,0,0,4" />

                                        <ComboBox Header="Type" MinWidth="120" SelectedValuePath="Tag" SelectedValue="{x:Bind Type, Mode=TwoWay}"
                                                  Grid.Row="1" Margin="0,0,0,4">
                                            <ComboBoxItem Content="Text" Tag="text"/>
                                            <ComboBoxItem Content="Selection" Tag="selection"/>
                                        </ComboBox>

                                        <TextBox Header="Placeholder Content" MinWidth="120" Text="{x:Bind PlaceholderContent, Mode=TwoWay}"
                                                 Margin="0,0,0,4" Grid.Row="2" VerticalAlignment="Top"/>

                                        <TextBox Header="Title" MinWidth="120" Text="{x:Bind Title,Mode=TwoWay}" Grid.Column="1"
                                                 Margin="8,0,0,4"/>

                                        <Button Grid.Column="1" Grid.Row="1" Margin="8,0,0,4" Height="32"
                                                Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Bottom">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Edit selections"/>
                                                <FontIcon Glyph="&#xE70D;" Margin="8,0,0,0" FontSize="16"/>
                                            </StackPanel>

                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <Button Content="Add selection" x:Name="addSelectionBtn" Tag="{x:Bind}"
                                                            Click="AddSelectionBtn_Click" Margin="8,0,0,8"/>

                                                        <ListView SelectionMode="None" ItemsSource="{x:Bind Options,Mode=OneWay}"
                                                            Grid.Row="1" Margin="8,0,0,4" MaxHeight="384">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="data:ToastSelection">
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                            <TextBox Text="{x:Bind Id,Mode=TwoWay}" Header="ID"/>
                                                                            <TextBox Text="{x:Bind Content,Mode=TwoWay}" Header="Content" MinWidth="120"
                                                                                     Margin="8,0,0,0" />
                                                                        </StackPanel>
                                                                        <Button Content="Remove" x:Name="removeSelectionButton"
                                                                                Click="RemoveSelectionButton_Click" Tag="{x:Bind}"
                                                                                Margin="0,0,0,12" Style="{StaticResource DeleteButtonStyle}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </Grid>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        
                                        <Button Content="Remove" Margin="8,0,0,4" x:Name="removeInputBtn" Grid.Row="2" Grid.Column="1"
                                            Tag="{x:Bind}" Click="RemoveInputBtn_Click" Style="{StaticResource DeleteButtonStyle}"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                    
                                    <MenuFlyoutSeparator Margin="0,8" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Header">
                <ScrollViewer>
                    <StackPanel>
                        <ToggleSwitch x:Name="useHeaderSwitch" Toggled="UseHeaderSwitch_Toggled" />

                        <TextBox Header="ID" IsEnabled="{x:Bind useHeaderSwitch.IsOn, Mode=OneWay}" Margin="0,8,0,0"
                                 x:Name="hdrIdBox" LostFocus="HdrIdBox_LostFocus"/>
                        <TextBox Header="Title" IsEnabled="{x:Bind useHeaderSwitch.IsOn, Mode=OneWay}" Margin="0,8,0,0"
                                 x:Name="hdrTitleBox" LostFocus="HdrTitleBox_LostFocus"/>
                        <TextBox Header="Arguments" IsEnabled="{x:Bind useHeaderSwitch.IsOn, Mode=OneWay}" Margin="0,8,0,0"
                                 x:Name="hdrArgsBox" LostFocus="HdrArgsBox_LostFocus"/>
                        <ComboBox Header="Activation Type" HorizontalAlignment="Stretch" IsEnabled="{x:Bind useHeaderSwitch.IsOn, Mode=OneWay}"
                                  Margin="0,8,0,0" SelectedIndex="0" x:Name="hdrActBox" SelectedValuePath="Tag" SelectionChanged="HdrActBox_SelectionChanged">

                            <ComboBoxItem Content="Default" Tag=""/>
                            <ComboBoxItem Content="Foreground" Tag="foreground"/>
                            <ComboBoxItem Content="Background" Tag="background"/>
                            <ComboBoxItem Content="Protocol" Tag="protocol"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Data">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock TextWrapping="WrapWholeWords" Margin="0,0,0,8">
                        Notification data allows you to bind values to different properties on various elements, and change
                        them without resending toasts. <Bold>Note:</Bold> Notification data is not part of the toast's XML
                        payload, however <Bold>Notification Editor</Bold> includes it to make testing your toast easier.
                        <LineBreak/>
                        <LineBreak/>
                        To bind to the notification data, use the syntax: {key} inside text fields. When binding to the
                        value for a progress bar, set the value of the data entry to a floating-point number from 0.0-1.0
                        to use a percentage, or the string "indeterminate".
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Grid.Row="1">
                        <Button Content="Add Entry" Style="{StaticResource SubtleButtonStyle}"
                                x:Name="addDataEntryButton" Click="AddDataEntryButton_Click"/>

                        <Line
                            X1="4"
                            Y1="4"
                            X2="4"
                            Y2="28"
                            Stroke="Gray"
                            StrokeThickness="0.8"
                            Margin="8,0" />

                        <Button Content="Update" x:Name="updateToastButton" Click="UpdateToastButton_Click"/>
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind DataItems,Mode=OneWay}" Grid.Row="2" SelectionMode="None" Margin="0,8,0,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="data:NotificationDataItem">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{x:Bind Key,Mode=TwoWay}" PlaceholderText="Key" HorizontalAlignment="Stretch"/>
                                    <TextBox Text="{x:Bind Value,Mode=TwoWay}" PlaceholderText="Value" Grid.Column="1" HorizontalAlignment="Stretch"
                                             Margin="8,0,0,0"/>
                                    <Button Style="{StaticResource DeleteButtonStyle}" ToolTipService.ToolTip="Delete" Grid.Column="2"
                                            Margin="8,0,0,0" x:Name="deleteDataItemButton" Click="DeleteDataItemButton_Click"
                                            Tag="{x:Bind}">
                                        <SymbolIcon Symbol="Delete"/>
                                    </Button> 
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                </Grid>
            </PivotItem>
            
            <PivotItem Header="XML">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="180"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox AcceptsReturn="True" x:Name="xmlBox" FontFamily="Consolas" ScrollViewer.VerticalScrollMode="Enabled"
                             Grid.ColumnSpan="2" IsSpellCheckEnabled="False" />

                    <TextBlock Grid.Row="1" Text="Warnings and errors (based on selected OS build)" VerticalAlignment="Center"/>

                    <Button Content="Save XML" Style="{StaticResource AccentButtonStyle}" Grid.Row="1" Grid.Column="1"
                            HorizontalAlignment="Right" x:Name="saveXmlButton" Click="SaveXmlButton_Click"/>

                    <ListView Grid.Row="2" x:Name="warningLv" ScrollViewer.VerticalScrollMode="Enabled" IsItemClickEnabled="True"
                              SelectionMode="None" ItemClick="WarningLv_ItemClick" Grid.ColumnSpan="2">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="data:ParseWarning">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="{x:Bind Glyph}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Error.Message}" TextWrapping="WrapWholeWords" HorizontalAlignment="Stretch" />
                                    
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right">
                                        <Run Text="{x:Bind LineNumber}"/>
                                        <Run Text="("/><Run Text="{x:Bind Source}"/><Run Text=")"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Normal">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641"/>
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>

                    <VisualState.Setters>
                        <Setter Target="previewPane.Visibility" Value="Collapsed"/>
                        <Setter Target="showPreviewButton.IsEnabled" Value="False"/>
                        <Setter Target="showPreviewButton.IsChecked" Value="False"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
