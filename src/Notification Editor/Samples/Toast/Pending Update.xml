<toast>  <visual>    <binding template="ToastGeneric">      <text hint-maxLines="2">Which lunch would you like?</text>    </binding>  </visual>  <actions>      <input id="lunch" type="selection" defaultInput="bbq">          <selection id="bbq" content="BBQ Burger"/>          <selection id="roast" content="Field Roast Sandwich (vegan)"/>         <selection id="fishAndChips" content="Fish &amp; chips"/>      </input>      <action content="Submit order" arguments="submit" activationType="background" afterActivationBehavior="pendingUpdate" />      <action content="Cancel" arguments="cancel" activationType="background" />  </actions></toast>